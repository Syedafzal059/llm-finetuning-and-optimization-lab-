# API Keys for medical-coding project
# Copy to .env and fill in real values
# NEVER commit .env to git

# Client API key
# Give this to the medical-coding client
CLIENT_API_KEY=

# Admin API key
# Only you use this for /metrics
ADMIN_API_KEY=

# Hugging Face token
# Needed to download Mistral 7B
HF_TOKEN=

# Alert email (crashes, quota warnings)
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
ALERT_EMAIL_PASSWORD=
