# ── Virtual environments ─────────────────────────────────────
venv/
.venv/

# ── Secrets (never commit) ───────────────────────────────────
.env
**/.env
.env.*
!**/.env.example
!.env.example

# ── Python bytecode & caches ─────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Local databases (usage tracking) ─────────────────────────
usage.db
**/usage.db

# ── Training checkpoints (large; regenerate locally) ─────────
model/
**/model/

# ── Runtime logs ─────────────────────────────────────────────
logs/
**/logs/
*.log

# ── Hugging Face & OS junk ───────────────────────────────────
.huggingface/
.DS_Store
Thumbs.db
