# Per-project API keys live in projects/{project_name}/.env
# Copy projects/clinical-notes/.env.example to projects/clinical-notes/.env

# Hugging Face token for gated models (Llama, Mistral, etc.)
HF_TOKEN=hf_your_huggingface_token_here

# Optional: SMTP for usage alert emails (shared across projects)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@yourdomain.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@yourdomain.com

# PM2 process manager (Vast.ai / production)
WORKSPACE=/workspace/llm-finetuning-lab
PM2_PYTHON=python
CUDA_VISIBLE_DEVICES=0

# PM2 crash alert emails (Gmail app password recommended)
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
ALERT_EMAIL_PASSWORD=
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=465

# Backup settings (3-2-1 rule: local + Google Drive + Backblaze B2)
BACKUP_DIR=/backups
GDRIVE_REMOTE=gdrive
B2_REMOTE=b2
B2_BUCKET=llm-finetuning-backups
GDRIVE_FOLDER=llm-finetuning-backups
KEEP_DAILY_DAYS=7
KEEP_WEEKLY_WEEKS=4

# Internal monitor (scripts/run_monitor.py via cron)
# MONITOR_PROJECTS=[{"name":"clinical-notes","port":8001},{"name":"medical-coding","port":8002},{"name":"patient-support","port":8003}]
MONITOR_REDIS_HOST=localhost
MONITOR_REDIS_PORT=6379
MONITOR_API_LATENCY_WARNING_MS=5000
MONITOR_GPU_WARNING_PCT=85
MONITOR_GPU_CRITICAL_PCT=95
MONITOR_QUEUE_WARNING_DEPTH=10
MONITOR_QUEUE_CRITICAL_DEPTH=20
MONITOR_DISK_WARNING_PCT=80
MONITOR_DISK_CRITICAL_PCT=90
MONITOR_BACKUP_WARNING_HOURS=26
MONITOR_BACKUP_CRITICAL_HOURS=48
MONITOR_PM2_RESTART_WARNING=5
MONITOR_ALERT_COOLDOWN_MINUTES=30
MONITOR_DAILY_SUMMARY_HOUR=8
MONITOR_HTTP_TIMEOUT_SECONDS=10
MONITOR_SUBPROCESS_TIMEOUT_SECONDS=15

# Cloudflare tunnel (HTTPS for client APIs — see docs/cloudflare_verify.md)
DOMAIN=yourdomain.com
TUNNEL_ID=
TUNNEL_NAME=llm-api-tunnel
CF_API_TOKEN=
